{
  "statusLine": {
    "type": "command",
    "command": "uv run \"$(git rev-parse --show-toplevel)/claudecodehub/.claude/statusline-command.py\""
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "engineering-workflow-skills@mhattingpete-claude-skills": true
  },
  "extraKnownMarketplaces": {
    "mhattingpete-claude-skills": {
      "source": {
        "source": "github",
        "repo": "mhattingpete/claude-skills-marketplace"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(chmod -R 777 *)",
      "Bash(chmod 777 *)",
      "Bash(* > /dev/sd*)",
      "Bash(* > /dev/nvme*)",
      "Read(./.env*)",
      "Edit(./.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/claudecodehub/.claude/hooks/pretooluse-bash-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
